<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    tools:context="com.gstolima.modulocaptnovedlect.ModuloActualizaAforos">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:shrinkColumns="0"
        android:stretchColumns="0">

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLogos"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@color/zxing_transparent"
                android:contentDescription="@string/info"
                android:scaleType="centerCrop"
                android:src="@drawable/iconguardar" />

            <ImageButton
                android:id="@+id/btnLogos2"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@color/zxing_transparent"
                android:contentDescription="@string/info"
                android:scaleType="centerInside"
                android:src="@drawable/notificacion" />
        </LinearLayout>
        <TextView
            android:id="@+id/txtTitleLicencia"
            android:layout_width="370dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_weight="1"
            android:background="@color/orangeCelsia"
            android:gravity="center|bottom"
            android:text="CAPTURA DE AFOROSLICENCIA"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:textStyle="bold">

        </TextView>

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="110dp"
            android:layout_marginTop="2dip"
            android:fillViewport="true"
            android:scrollbarStyle="outsideInset"
            android:contentDescription="Selector"
            android:scrollbars="horizontal|vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TableLayout
                    android:id="@+id/tblcliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:layout_marginTop="1dp">

                </TableLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TableLayout
                android:id="@+id/tblcabeceraforo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TableLayout>

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="110dp"
                android:layout_marginTop="1dip"
                android:fillViewport="true"
                android:scrollbarStyle="outsideInset"
                android:contentDescription="Selector"
                android:scrollbars="horizontal|vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TableLayout
                        android:id="@+id/tblaforos"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="1dp">

                    </TableLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aforo"
            android:textSize="16dp" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:background="@color/bluePopSoft" />

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="1dp"
            android:background="@color/grayBlueSoft">

            <EditText
                android:id="@+id/txtCodigoAforo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bordes"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:paddingLeft="4dp"
                android:singleLine="true"
                android:hint="Codigo Aforo"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/txtCmbAforos"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_weight="3"
                android:background="@color/grayBlueSoft"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Aforos"
                android:focusableInTouchMode="false"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/imgbtnaforos"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:contentDescription="Aforo"
                android:src="@drawable/ddm300" />

        </TableRow>

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="5dp"
            android:background="@color/bluePopSoft" />

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="Cantidad"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtCantidaEquipos"
                android:layout_width="0dp"
                android:layout_height="55px"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:layout_marginTop="2dp"
                android:layout_weight="2"
                android:background="@drawable/bg_bordes"
                android:inputType="number"
                android:maxLength="3"
                android:hint="Cantidad"
                android:paddingLeft="3dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="40dp"
                android:layout_weight="1"
                android:text="TOTAL W"
                android:textSize="16sp" />


        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="Watts"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtVatiosAforo"
                android:layout_width="0dp"
                android:layout_height="55px"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:layout_marginTop="2dp"
                android:layout_weight="2"
                android:background="@drawable/bg_bordes"
                android:focusable="false"
                android:maxLength="8"
                android:hint="Vatios Aforo"
                android:paddingLeft="3dp" />

            <TextView
                android:id="@+id/lbltotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/redPopHard"
                android:textSize="16sp" />


        </TableRow>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tipo de coneccion"
            android:textSize="16sp" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:background="@color/bluePopSoft" />

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_margin="1dp"
            android:background="@color/grayBlueSoft">

            <EditText
                android:id="@+id/txtTipoAforo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bordes"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:paddingLeft="4dp"
                android:singleLine="true"
                android:hint="Cod Tipo Aforo"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/txtCmbTipoAforo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:layout_marginRight="5dp"
                android:layout_weight="3"
                android:background="@color/grayBlueSoft"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Tipo Aforo"
                android:focusableInTouchMode="false"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/imgbtnaforostipo"
                android:layout_width="38dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="fitXY"
                android:contentDescription="Sel Tipos"
                android:src="@drawable/ddm300" />

        </TableRow>

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dp"
            android:background="@color/bluePopSoft" />

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnGrabarAforo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_redondeado"
                android:enabled="false"
                android:text="Grabar"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnReturnaforos"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_redondeado"
                android:text="Retornar"
                android:textColor="@color/white" />

        </TableRow>
    </TableLayout>
</LinearLayout>
