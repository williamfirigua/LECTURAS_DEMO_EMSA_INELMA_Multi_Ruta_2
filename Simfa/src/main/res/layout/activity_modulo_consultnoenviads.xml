<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/orangeCelsia"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📤 CONSULTA NO ENVIADOS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- CARD TABLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="6dp">

            <!-- CABECERA -->
            <TableLayout
                android:id="@+id/tblcabecera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:padding="4dp"/>

            <!-- TABLA -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <TableLayout
                        android:id="@+id/tblcuentacontador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </ScrollView>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- INFO PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📦 No enviados:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/txtregnoenviados"
                android:layout_width="300dp"
                android:layout_height="48dp"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/lblpos"
                android:text="0/0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_weight="1"/>
        </LinearLayout>

    </LinearLayout>

    <!-- NAVEGACIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnPrimeroNe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_cycle2"
            android:contentDescription="Atras"
            android:src="@android:drawable/ic_media_rew" />

        <ImageButton
            android:id="@+id/btnAtrasNe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_cycle2"
            android:contentDescription="Primero"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/btnAdelanteNe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_cycle2"
            android:contentDescription="Ultimo"
            android:src="@android:drawable/ic_media_next" />

        <ImageButton
            android:id="@+id/btnUltimoNe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_cycle2"
            android:contentDescription="Adelante"
            android:src="@android:drawable/ic_media_ff" />

        <ImageButton
            android:id="@+id/btnCerrarNe2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_cycle2"
            android:contentDescription="Cerrar"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

    </LinearLayout>

</LinearLayout>