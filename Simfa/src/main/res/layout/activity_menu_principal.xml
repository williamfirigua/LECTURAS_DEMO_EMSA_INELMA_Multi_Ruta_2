<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.gstolima.accesoyseguridad.MenuPrincipal">

    <TableLayout
        android:id="@+id/tableLayout1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnLogos"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:background="@color/zxing_transparent"
                android:contentDescription="@string/info"
                android:scaleType="centerInside"
                android:src="@drawable/simle_logolecturas2" />

            <TextView
                android:id="@+id/txtTitleMenuPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="right|bottom"
                android:layout_weight="1"
                android:background="@color/orangeCelsia"
                android:gravity="center|bottom"
                android:text="MENU PRINCIPAL"
                android:textColor="@color/white"

                android:textSize="15dp"
                android:textStyle="bold">

            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="20dp"></LinearLayout>

        <!--Primer visualizador organizador de los graficos o botones-->

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal">

                <!--primer linea de botones-->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnIniciarLecturas"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/iniciar_lecturas"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/rutero12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rutero"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnUtilidades"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/utilidades"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/utilitario31" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Utilitarios"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!--Bloque dos de botonera -->

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnRetornar"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/retornar"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/retornar31" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Retornar"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnElimnarInfo"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/eliminar_info"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/eliminar23" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eliminar"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!--Bloque tres de botonera -->

            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnComunica"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/menucomunicacion"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/comunica1" />
                    <!--                android:enabled="false"-->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menu Comunicaciones"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <!--                android:clickable="false"-->

                    <ImageButton
                        android:id="@+id/btnAyuda"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_icon_button_selector"
                        android:contentDescription="@string/menuayuda"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/validarenvio" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ayuda"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>


        </LinearLayout>
        <!--finaliza los botones en su regla de bordes principales-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="20dp"></LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"

                android:background="@color/zxing_transparent"
                android:contentDescription="@string/info"
                android:scaleType="centerInside"
                android:src="@drawable/formato_de_archivo" />

            <TextView
                android:id="@+id/txtArchivoCargado"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Movil Sin Archivo Cargado"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAppearance="?android:attr/textAppearanceLarge" />
        </LinearLayout>
    </TableLayout>
</RelativeLayout>