<?xml version="1.0" encoding="utf-8"?>

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <TableLayout
        android:id="@+id/tableLayout1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="119dp"
                android:layout_height="80dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/simle_logolecturas2" />

            <TextView
                android:id="@+id/txtTitleHoraFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/orangeCelsia"
                android:gravity="center"
                android:text="INFO. CAMBIO MEDIDOR"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </TableRow>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="Direccion"
                android:textSize="16dp" />

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <EditText
                    android:id="@+id/txtcnDireccion"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="right"
                    android:layout_marginRight="7dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890 "
                    android:inputType="text"
                    android:maxLength="60"
                    android:hint="Digite Direccion"
                    android:paddingLeft="3dp"
                    android:privateImeOptions="nm"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/txtcnContador"/>

            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Contador"
                    android:textSize="16dp" />

                <EditText
                    android:id="@+id/txtcnContador"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="28dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="number"
                    android:maxLength="20"
                    android:paddingLeft="3dp"
                    android:hint="Digite Contador"
                    android:privateImeOptions="nm"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/txtcuMarca"/>
            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Marca"
                    android:textSize="16dp" />

                <EditText
                    android:id="@+id/txtcuMarca"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="left"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="28dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                    android:inputType="text"
                    android:maxLength="15"
                    android:paddingLeft="3dp"
                    android:hint="Digite Marca"
                    android:privateImeOptions="nm"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/spnTipoMedida"/>
            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Tipo Medida"
                    android:textSize="16dp" />

                <Spinner
                    android:id="@+id/spnTipoMedida"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="left"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="28dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    android:entries="@array/tipos_medidor"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/txtcnDigitos"></Spinner>
            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Cod. Referencia"
                    android:textSize="16dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/txtcnrRefer"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="7dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingLeft="3dp"
                    android:hint="Digite Referencia"
                    android:privateImeOptions="nm"
                    android:visibility="gone"/>

            </TableRow>
            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
          >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Digitos"
                    android:textSize="16dp" />



                <EditText
                    android:id="@+id/txtcnDigitos"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="left"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="28dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="number"
                    android:maxLength="1"
                    android:paddingLeft="3dp"
                    android:privateImeOptions="nm"
                    android:imeOptions="actionNext"

                    android:nextFocusDown="@id/txtcnLectura"
                     />
            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
          >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Observ."
                    android:textSize="16dp"
                    />

                <EditText
                    android:id="@+id/txtcnObserv"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="left"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="28dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingLeft="3dp"
                    android:privateImeOptions="nm" />
            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="Lectura"
                    android:textSize="16dp" />

                <EditText
                    android:id="@+id/txtcnLectura"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="28dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="number"
                    android:maxLength="7"
                    android:paddingLeft="3dp"
                    android:hint="DigiteLectura"
                    android:privateImeOptions="nm"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/btncnfoto"/>
            </TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="Informe"
                android:textSize="16sp"
                android:visibility="gone"/>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:gravity="center">

                <EditText
                    android:id="@+id/txtcuInforme"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="right"
                    android:layout_marginRight="7dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_bordes"
                    android:inputType="text"
                    android:maxLength="60"
                    android:paddingLeft="3dp"
                    android:hint="Digite Informe"
                    android:privateImeOptions="nm"
                    android:visibility="gone"/>

            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center">

            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btncnfoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_boton_redondeado"
                    android:text="Capturar Fotografia"
                    android:textColor="@color/white"
                    android:visibility="gone" />


            </TableRow>

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btncngrabar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_boton_redondeado"
                    android:text="GRABAR"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btncnreotornar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_boton_redondeado"
                    android:text="RETORNAR"
                    android:textColor="@color/white" />
            </TableRow>

        </TableLayout>
    </TableLayout>

        </LinearLayout>

    </ScrollView>
