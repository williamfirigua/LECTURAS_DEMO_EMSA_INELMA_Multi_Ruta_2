<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.gstolima.comunicaciones.Comunicaciones">

    <TableLayout
        android:id="@+id/tabla_cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableRow
            android:id="@+id/tableComunicaciones"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/formato_de_archivo"
            android:gravity="right"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/txtTitleComunicaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_weight="1"
                android:background="@color/purpletolima"
                android:gravity="center|bottom"
                android:text="COMUNICACIONES"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:textStyle="bold">

            </TextView>
        </TableRow>

        <TableRow
            android:id="@+id/tableRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:weightSum="8">

            <TextView
                android:id="@+id/lblCiclo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="CICLO" />

            <EditText
                android:id="@+id/txtCiclo"
                android:layout_width="134dp"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="0"
                android:inputType="number"
                android:maxLength="9"
                android:text="000000000" />

            <Button
                android:id="@+id/btnTraerRuta"
                android:layout_width="277dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@color/redPop"
                android:gravity="center"
                android:text="  Traer Ruta   " />

        </TableRow>

        <TableRow
            android:id="@+id/tableRow21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:weightSum="8">

            <TextView
                android:id="@+id/lblMunicipio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="MUNICIPIO" />

            <EditText
                android:id="@+id/txtMunicipio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="0"
                android:inputType="number"
                android:maxLength="2"
                android:text="00" />

            <Button
                android:id="@+id/btnRecibirDatos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@color/bluePop"
                android:gravity="center"
                android:text="Recibir Datos" />

        </TableRow>

        <TableRow
            android:id="@+id/tableRow31"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:weightSum="8">

            <TextView
                android:id="@+id/lblSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="SECCION" />

            <EditText
                android:id="@+id/txtSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="0"
                android:inputType="number"
                android:maxLength="3"
                android:text="000" />

            <Button
                android:id="@+id/btnEnviarDatos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@color/ocrePop"
                android:gravity="center"
                android:text="Enviar Datos" />

        </TableRow>

        <TableRow
            android:id="@+id/tableRow41"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:weightSum="8">

            <TextView
                android:id="@+id/lblDivision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="DIVISION" />

            <EditText
                android:id="@+id/txtDivision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="0"
                android:inputType="number"
                android:maxLength="1"
                android:text="0" />

            <Button
                android:id="@+id/btnValidaEnvio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@color/greenPop"
                android:gravity="center"
                android:text="Valida Envio " />

        </TableRow>

        <TableRow
            android:id="@+id/tableRow51"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:weightSum="8">

            <TextView
                android:id="@+id/lblArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text="Archivo" />

            <TextView
                android:id="@+id/lblTxtArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnSpan="1"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="0"
                android:text=" ARCHIVO ." />

            <Button
                android:id="@+id/btnEnviarFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="7"
                android:background="@color/purplePop"
                android:gravity="center"
                android:text="Enviar Fotos" />

        </TableRow>

    </TableLayout>

    <TableLayout
        android:id="@+id/tabla_cuerp2o"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="8">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:text=".. .. .... "
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="15dp" />

            <ImageView
                android:id="@+id/iconwebserviceon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|right"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/red_activa"
                android:maxHeight="36dp"
                android:maxWidth="36dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/webserviceon"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iconwebserviceoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|right"
                android:layout_marginRight="5dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/red_activa"
                android:maxHeight="36dp"
                android:maxWidth="36dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/webserviceoff"
                android:visibility="visible" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"></TableRow>

    </TableLayout>

    <TableLayout
        android:id="@+id/tabla_cuerpo2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp">

            <Button
                android:id="@+id/btnBackupFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:background="@color/bluePopSoft"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:textColor="@color/white"
                android:text=" Backup \nFotos "
                android:textSize="14dp" />

            <Button
                android:id="@+id/btnBorrarBackupFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@color/purplePopHard"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:text="Borrar Backup\nFotos"
                android:textColor="@color/white"
                android:textSize="14dp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp">

            <Button
                android:id="@+id/btnValidarVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:background="@color/greenPopHard"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:text="Validar \nVersion"
                android:textColor="@color/white"
                android:textSize="14dp" />

            <Button
                android:id="@+id/btnConfigurarWeb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:layout_marginRight="5dp"
                android:background="@color/bluePopHard"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:text="  Configurar  \n  WebService  "
                android:textColor="@color/white"
                android:textSize="14dp" />

        </TableRow>


        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp">

            <Button
                android:id="@+id/btnRegresar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:layout_weight="1"
                android:background="@color/grayPop"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="1"
                android:text="Regresar" />

        </TableRow>
    </TableLayout>


</LinearLayout>


