<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surfaceViewCamara"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnCancelarCaptura"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="Cancelar"
        android:src="@drawable/ic_cerrar"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="Flash"
        android:src="@drawable/ic_flash_off"
        app:tint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="@android:color/black"
        android:shadowRadius="8"
        android:shadowDx="0"
        android:shadowDy="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/panelInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnZoom1x"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1x"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:background="@drawable/bg_boton_zoom" />

            <Button
                android:id="@+id/btnZoom2x"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="2x"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:background="@drawable/bg_boton_zoom" />

        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgTemporizador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbTemporizadorOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin Temp."
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbTemporizador3s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3s"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbTemporizador5s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5s"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rbTemporizador10s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10s"
                android:textColor="@android:color/white"
                android:buttonTint="@android:color/white" />

        </RadioGroup>

        <ImageButton
            android:id="@+id/btnCapturarFoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_boton_captura"
            android:contentDescription="Tomar Foto"
            android:src="@android:color/transparent" />

    </LinearLayout>

    <!-- Panel de revision: se muestra despues de capturar, oculta todo lo demas -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelRevision"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgRevisionFoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:contentDescription="Foto capturada"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/panelBotonesRevision"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/panelBotonesRevision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:background="#CC000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnRepetirFoto"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="48dp"
                android:background="@drawable/bg_boton_zoom"
                android:contentDescription="Repetir"
                android:src="@drawable/ic_cerrar"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnAceptarFoto"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_boton_zoom"
                android:contentDescription="Aceptar"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
